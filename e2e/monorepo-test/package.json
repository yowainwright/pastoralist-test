{
  "name": "pastoralist-monorepo-test",
  "version": "1.0.0",
  "description": "Monorepo test scenario for pastoralist",
  "type": "module",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test.js",
    "postinstall": "pastoralist"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {},
  "overrides": {
    "semver": "7.5.3",
    "tough-cookie": "4.1.3"
  },
  "pastoralist": {
    "appendix": {
      "semver@7.5.3": {
        "dependents": {
          "iconv-lite": "semver@*",
          "object-inspect": "semver@^6.3.1",
          "@monorepo-test/lib": "semver@^7.6.0"
        }
      },
      "tough-cookie@4.1.3": {
        "dependents": {
          "@monorepo-test/lib": "tough-cookie@^4.1.0"
        }
      }
    }
  }
}