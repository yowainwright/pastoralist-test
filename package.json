{
  "name": "pastoralist-test",
  "version": "1.0.0",
  "description": "End-to-end test suite for Pastoralist - ensuring dependency override tracking works across package managers",
  "private": true,
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "cd e2e && ./run-tests.sh",
    "test:e2e:npm": "cd e2e && docker-compose run --rm npm-test",
    "test:e2e:yarn": "cd e2e && docker-compose run --rm yarn-test",
    "test:e2e:pnpm": "cd e2e && docker-compose run --rm pnpm-test",
    "test:e2e:bun": "cd e2e && docker-compose run --rm bun-test",
    "test:e2e:patches": "cd e2e && docker-compose run --rm patches-test",
    "test:e2e:peer-deps": "cd e2e && docker-compose run --rm peer-deps-test",
    "test:e2e:monorepo": "cd e2e && docker-compose run --rm monorepo-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/pastoralist-test.git"
  },
  "keywords": [
    "pastoralist",
    "testing",
    "e2e",
    "package-manager",
    "dependency-tracking",
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "overrides",
    "resolutions"
  ],
  "author": "Jeff Wainwright (yowainwright@gmail.com) <https://jeffry.in>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yowainwright/pastoralist-test/issues"
  },
  "homepage": "https://github.com/yowainwright/pastoralist-test#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "pastoralist": "latest"
  }
}
